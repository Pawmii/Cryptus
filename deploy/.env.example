# Public hostname (Caddy obtains a TLS certificate automatically)
CRYPTUS_DOMAIN=pay.example.com
CRYPTUS_VERSION=latest

# PostgreSQL
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Managed signing (optional) — enable with:  --profile managed-signing
# CRYPTUS_SIGNER_URL=http://signer:8700

# Bitcoin Core (optional) — enable with:  --profile bitcoind
BITCOIND_RPC_USER=cryptus
BITCOIND_RPC_PASSWORD=change-me
